# ==========================================================
# Environment Variables Template (.env.example)
# Database Engine: MySQL / phpMyAdmin (XAMPP/WAMP)
# Database Name: hand_off_oil
# phpMyAdmin URL: http://localhost/phpmyadmin/index.php?route=/database/structure&db=hand_off_oil
# ==========================================================

# Database Credentials
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hand_off_oil
DB_USER=root
DB_PASSWORD=

# Main Database Connection String for MySQL / phpMyAdmin:
# If you have NO password (default XAMPP):
DATABASE_URL=mysql+pymysql://root:@localhost:3306/hand_off_oil

# If you set a root password in MySQL:
# DATABASE_URL=mysql+pymysql://root:YOUR_PASSWORD@localhost:3306/hand_off_oil

# API & Security Keys
API_KEY=your_api_key_here
SECRET_KEY=your_secret_key_here

# Application Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

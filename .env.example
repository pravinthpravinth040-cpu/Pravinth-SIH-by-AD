# ==========================================================
# Environment Variables Template (.env.example)
# ==========================================================

# Frontend API Endpoint (URL of deployed cloud backend)
VITE_API_BASE_URL=https://sentinel1-sar-oil-spill-api.onrender.com
VITE_API_URL=https://sentinel1-sar-oil-spill-api.onrender.com

# Application Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (Comma separated - or * for open access)
CORS_ORIGINS=https://pravinthpravinth040-cpu.github.io,http://localhost:8000,http://localhost:3000,http://localhost:5173,http://127.0.0.1:5500

# Optional Database Engine: MySQL / phpMyAdmin (XAMPP/WAMP)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hand_off_oil
DB_USER=root
DB_PASSWORD=
DATABASE_URL=mysql+pymysql://root:@localhost:3306/hand_off_oil

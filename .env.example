# ==========================================================
# Environment Variables Template (.env.example)
# ==========================================================

# Frontend API Endpoint (URL of deployed cloud backend)
VITE_API_URL=https://YOUR-DEPLOYED-BACKEND-URL

# Application Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (Comma separated)
CORS_ORIGINS=https://pravinthpravinth040-cpu.github.io,http://localhost:8000,http://localhost:8080

# Optional Database Engine: MySQL / phpMyAdmin (XAMPP/WAMP)
DB_ENGINE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=hand_off_oil
DB_USER=root
DB_PASSWORD=
DATABASE_URL=mysql+pymysql://root:@localhost:3306/hand_off_oil
